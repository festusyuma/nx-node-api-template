// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/utils/types"
  fileName = "database.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String     @unique
  email     String     @unique
  password  String
  status    UserStatus @default(INACTIVE)
  roleId    String     @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime?  @updatedAt @map("updated_at")

  agent       Agent?
  agencyAdmin AgencyAdmin?

  role Role @relation(fields: [roleId], references: [id])
}

model Role {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  key  String @unique

  users User[]
}

model Agency {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  paymentLink String?
  email       String
  phoneNumber String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  agents      Agent[]
  PaymentType PaymentType[]
  agencyAdmin AgencyAdmin[]
  Business    Business[]
  tasks       Task[]
}

model AgencyAdmin {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastName  String
  firstName String
  agencyId  String @db.Uuid
  userId    String @unique @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Agent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastName  String
  firstName String
  userId    String    @unique @db.Uuid
  agencyId  String    @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id])
  agency            Agency             @relation(fields: [agencyId], references: [id])
  businessLocations BusinessLocation[]
  tasks             Task[]
  Business          Business[]
}

model Business {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phoneNumber    String
  email          String
  qrCode         String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         BusinessStatus @default(UNVERIFIED)
  reasonRejected String?
  additionalData Json           @default("{}")
  agencyId       String         @db.Uuid
  isAssigned     Boolean        @default(false)
  agentId        String?        @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  locations   BusinessLocation[]
  documents   BusinessDocument[]
  Transaction Transaction[]
  Signage     Signage[]
  Agency      Agency             @relation(fields: [agencyId], references: [id])
  Agent       Agent?             @relation(fields: [agentId], references: [id])

  Task Task[]
}

model BusinessDocument {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  files          String[]
  reasonRejected String?
  status         BusinessDocumentStatus @default(PENDING)
  businessId     String                 @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime?              @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessLocation {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  images        String[]
  latitude      Decimal                @db.Decimal(10, 5)
  longitude     Decimal                @db.Decimal(10, 5)
  streetAddress String
  city          String
  state         String
  country       String
  businessId    String                 @db.Uuid
  agentId       String?                @db.Uuid
  status        BusinessLocationStatus @default(UNVERIFIED)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime?              @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])
  agent    Agent?   @relation(fields: [agentId], references: [id])
}

model Otp {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  otp            String
  expirationTime DateTime  @default(dbgenerated("NOW() + interval '10 minutes'"))
  verified       Boolean?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
}

model Transaction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentTypeId String            @db.Uuid
  businessId    String            @db.Uuid
  reference     String
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime?         @updatedAt @map("updated_at")

  paymentType   PaymentType    @relation(fields: [paymentTypeId], references: [id])
  business      Business       @relation(fields: [businessId], references: [id])
  SignagePermit SignagePermit?
}

model PaymentType {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId      String          @db.Uuid
  name          String
  amount        Int
  agency        Agency          @relation(fields: [agencyId], references: [id])
  transaction   Transaction[]
  SignagePermit SignagePermit[]
}

model Signage {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          SignageType
  size          SignageSize     @default(UP_TO_1_0)
  size_type     SignageSizeType @default(INCH)
  zone          SignageZone     @default(NORMAL)
  imageUrl      String?
  latitude      Decimal         @db.Decimal(10, 5)
  longitude     Decimal         @db.Decimal(10, 5)
  streetAddress String
  city          String?
  state         String?
  country       String?
  businessId    String          @db.Uuid
  business      Business        @relation(fields: [businessId], references: [id])
  status        SignageStatus   @default(PENDING)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime?       @updatedAt @map("updated_at")
  Permit        SignagePermit[]
  Task          Task[]
}

model SignagePermit {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status        SignagePermitStatus @default(NOT_APPLICABLE)
  paymentTypeId String              @db.Uuid
  paymentType   PaymentType         @relation(fields: [paymentTypeId], references: [id])
  signageId     String              @db.Uuid
  signage       Signage             @relation(fields: [signageId], references: [id])
  expiryDate    DateTime?
  paymentId     String              @unique @db.Uuid
  payment       Transaction         @relation(fields: [paymentId], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime?           @updatedAt @map("updated_at")
}

model Task {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status     TaskStatus @default(PENDING)
  agencyId   String     @db.Uuid
  agentId    String     @db.Uuid
  type       TaskType
  businessId String?    @db.Uuid
  signageId  String?    @db.Uuid

  agent    Agent     @relation(fields: [agentId], references: [id])
  agency   Agency    @relation(fields: [agencyId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])
  signage  Signage?  @relation(fields: [signageId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
}

enum BusinessLocationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum BusinessStatus {
  UNVERIFIED
  PENDING
  PENDING_AGENT_VERIFICATION
  COMPLETE_AGENT_VERIFICATION
  VERIFIED
  REJECTED
}

enum BusinessDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum SignageType {
  FLAT_SIZE
  LED
  DIRECTIONAL_SIGN
  SKY_SIGN
  CANOPY_SIGN
  NEON
  STREET_LAMP_POLE
  BOUNDARY_WALL_SIGN
  PROJECTING_SIGN
  ROOF_SIGN
  NON_PROFIT_SIGN
  FREE_STANDING
  OTHERS
}

enum SignagePermitStatus {
  NOT_APPLICABLE
  EXPIRED
  ACTIVE
}

enum SignageSizeType {
  INCH
  SQM
}

enum SignageStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SignageZone {
  NORMAL
  RESTRICTIVE
  HIGH_STREET
  RURAL
  LOCAL_INTERNATIONAL_AIRPORT
}

enum SignageSize {
  UP_TO_1_0
  UP_TO_3_0
  UP_TO_5_0
  UP_TO_7_0
  UP_TO_10_0
  UP_TO_13_0
  UP_TO_25_0
  ABOVE_25_0
}

enum TaskType {
  SIGNAGE_VERIFICATION
  BUSINESS_VERIFICATION
}

enum TaskStatus {
  PENDING
  COMPLETED
}
