// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/utils/types"
  fileName = "database.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String     @unique
  email    String     @unique
  password String
  status   UserStatus @default(INACTIVE)
  roleId   String     @db.Uuid

  agent Agent?
  role  Role   @relation(fields: [roleId], references: [id])
}

model Role {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  key  String @unique

  users User[]
}

model Agency {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String

  agents Agent[]
}

model Agent {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastName  String
  firstName String
  userId    String @unique @db.Uuid
  agencyId  String @db.Uuid

  user              User               @relation(fields: [userId], references: [id])
  agency            Agency             @relation(fields: [agencyId], references: [id])
  businessLocations BusinessLocation[]
}

model Business {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phoneNumber    String
  email          String
  additionalData Json   @default("{}")

  locations BusinessLocation[]
  documents BusinessDocument[]
}

model BusinessDocument {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  files          String[]
  reasonRejected String?
  status         BusinessDocumentStatus @default(PENDING)
  businessId     String                 @db.Uuid

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessLocation {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  images        String[]
  latitude      Decimal
  longitude     Decimal
  streetAddress String
  city          String
  state         String
  country       String
  businessId    String                 @db.Uuid
  agentId       String?                @db.Uuid
  status        BusinessLocationStatus @default(UNVERIFIED)

  business Business @relation(fields: [businessId], references: [id])
  agent    Agent?   @relation(fields: [agentId], references: [id])
}

model Otp {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  otp            String
  expirationTime DateTime  @default(dbgenerated("NOW() + interval '10 minutes'"))
  verified       Boolean?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
}

enum BusinessLocationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum BusinessDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}
